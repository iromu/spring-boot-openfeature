<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.iromu.openfeature</groupId>
  <artifactId>spring-boot-openfeature</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Spring Boot OpenFeature</name>
  <description>Spring Boot OpenFeature</description>
  <url>https://github.com/iromu/spring-boot-openfeature/tree/main</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Ivan Rodriguez</name>
      <email>wantez@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/iromu/spring-boot-openfeature.git</connection>
    <developerConnection>scm:git:ssh://github.com:iromu/spring-boot-openfeature.git</developerConnection>
    <url>http://github.com/iromu/spring-boot-openfeature/tree/main</url>
  </scm>

  <modules>
    <module>spring-boot-starter-openfeature</module>
    <module>spring-boot-openfeature-dependencies</module>
    <module>spring-boot-openfeature-autoconfigure</module>
    <module>spring-boot-starter-openfeature-configcat</module>
    <module>spring-boot-starter-openfeature-envvar</module>
    <module>spring-boot-starter-openfeature-flagd</module>
    <module>spring-boot-starter-openfeature-flagsmith</module>
    <module>spring-boot-starter-openfeature-flipt</module>
    <module>spring-boot-starter-openfeature-gofeatureflag</module>
    <module>spring-boot-starter-openfeature-jsonlogic</module>
    <module>spring-boot-starter-openfeature-multiprovider</module>
    <module>spring-boot-starter-openfeature-ofrep</module>
    <module>spring-boot-starter-openfeature-statsig</module>
    <module>spring-boot-starter-openfeature-unleash</module>
    <module>spring-openfeature</module>
    <module>spring-boot-starter-openfeature-growthbook</module>
    <module>spring-boot-starter-openfeature-gcp</module>
    <module>spring-boot-starter-openfeature-optimizely</module>
    <module>spring-boot-starter-openfeature-launchdarkly</module>
    <module>spring-boot-starter-openfeature-datadog</module>
    <module>spring-boot-starter-openfeature-split</module>
    <module>spring-boot-starter-openfeature-devcycle</module>
    <module>spring-boot-starter-openfeature-featbit</module>
    <module>spring-boot-starter-openfeature-featureflip</module>
    <module>spring-boot-starter-openfeature-mixpanel</module>
    <module>spring-boot-starter-openfeature-kameleoon</module>
    <module>spring-boot-starter-openfeature-confidence</module>
    <module>spring-boot-starter-openfeature-octopusdeploy</module>
    <module>spring-boot-starter-openfeature-vwo</module>
    <module>spring-boot-starter-openfeature-superposition</module>
    <module>spring-boot-starter-openfeature-ageris</module>
    <module>spring-boot-starter-openfeature-cloudbees</module>
    <module>spring-boot-starter-openfeature-configdirector</module>
  </modules>

  <properties>
    <revision>4.1.4-SNAPSHOT</revision>
    <java.version>17</java.version>

    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>4.1.2</spring-boot.version>
    <io.spring.javaformat.version>0.0.48</io.spring.javaformat.version>

    <!-- Per-module JaCoCo instruction-coverage floor (the ratchet). The root default
         keeps the gate green everywhere; each module overrides this in its own
         <properties> with the instruction COVEREDRATIO it actually achieves. -->
    <jacoco.instruction.minimum>0.0</jacoco.instruction.minimum>

    <sdk.version>1.23.0</sdk.version>

    <configcat.version>0.2.1</configcat.version>
    <env-var.version>0.0.12</env-var.version>
    <flagd.version>0.15.0</flagd.version>
    <flagsmith.version>0.0.13</flagsmith.version>
    <flagsmith-java-client.version>8.4.0</flagsmith-java-client.version>
    <flipt.version>0.1.4</flipt.version>
    <gcp.version>0.0.2</gcp.version>
    <go-feature-flag.version>2.0.2</go-feature-flag.version>
    <google-cloud-secretmanager.version>2.102.0</google-cloud-secretmanager.version>
    <google-cloud-parametermanager.version>0.46.0</google-cloud-parametermanager.version>
    <jsonlogic-eval-provider.version>1.3.0</jsonlogic-eval-provider.version>
    <multiprovider.version>0.0.3</multiprovider.version>
    <ofrep.version>0.0.2</ofrep.version>
    <statsig.version>0.2.1</statsig.version>
    <unleash.version>0.1.3-alpha</unleash.version>
    <unleash-client-java.version>12.3.2</unleash-client-java.version>

    <okhttp.version>5.5.1</okhttp.version>

    <growthbook-sdk-java.version>0.12.0</growthbook-sdk-java.version>
    <growthbook-provider.version>0.0.2</growthbook-provider.version>

    <optimizely.version>1.0.0</optimizely.version>
    <optimizely-sdk.version>4.7.0</optimizely-sdk.version>

    <!-- Required by the Optimizely SDK's config parser (com.optimizely.ab:core-api does
         not declare org.json itself); without it the parser hits NoSuchMethodError on
         JSONObject.keySet() for any datafile/fetched config. -->
    <json.version>20260814</json.version>

    <launchdarkly-openfeature.version>1.1.1</launchdarkly-openfeature.version>
    <!-- Declared explicitly (not transitively): the OpenFeature provider publishes the
         LaunchDarkly SDK in runtime scope, and the starter compiles against LDConfig. -->
    <launchdarkly-java-server-sdk.version>7.9.1</launchdarkly-java-server-sdk.version>

    <datadog-openfeature.version>1.68.1</datadog-openfeature.version>

    <split-openfeature.version>1.2.2</split-openfeature.version>
    <split-java-client.version>4.19.1</split-java-client.version>

    <!-- DevCycle's OpenFeature provider (com.devcycle.sdk.server.openfeature.DevCycleProvider)
         ships inside the DevCycle Java server SDK. -->
    <devcycle-openfeature.version>2.10.0</devcycle-openfeature.version>

    <featbit-openfeature.version>1.0.0</featbit-openfeature.version>
    <!-- Declared explicitly (not transitively): the provider publishes the FeatBit SDK in an
         open version range, and the starter compiles against FBConfig. -->
    <featbit-java-sdk.version>1.4.4</featbit-java-sdk.version>
    <featureflip-openfeature.version>0.2.1</featureflip-openfeature.version>

    <!-- The Mixpanel OpenFeature provider (com.mixpanel.openfeature.MixpanelProvider) ships
         in the Mixpanel Java SDK's openfeature module; it transitively pulls an older
         dev.openfeature:sdk, which the starter pins to ${sdk.version} (lockstep). -->
    <mixpanel-openfeature.version>0.2.0</mixpanel-openfeature.version>
    <kameleoon-openfeature.version>0.0.1</kameleoon-openfeature.version>
    <!-- Declared explicitly (not transitively): the starter compiles against
         KameleoonClientConfig, which ships in the Kameleoon Java client the provider uses. -->
    <kameleoon-client-java.version>4.5.0</kameleoon-client-java.version>
    <!-- Confidence's OpenFeature provider, published by Spotify alongside the Confidence
         SDK (com.spotify.confidence:sdk-java). -->
    <confidence-openfeature.version>0.7.0</confidence-openfeature.version>
    <octopusdeploy-openfeature.version>2.1.0</octopusdeploy-openfeature.version>
    <!-- VWO's OpenFeature provider (com.vwo.VWOProvider); the provider declares
         dev.openfeature:sdk at an older version, which the starter pins to
         ${sdk.version} (lockstep). -->
    <vwo-openfeature.version>1.0.0</vwo-openfeature.version>
    <!-- Declared explicitly (not transitively): the provider ships the VWO FME SDK at
         runtime scope, but the starter compiles against com.vwo.VWO, which ships in it
         (referenced by VWOProvider's constructor signature). -->
    <vwo-fme-java-sdk.version>1.8.1</vwo-fme-java-sdk.version>

    <!-- The Superposition OpenFeature provider (io.juspay.superposition.openfeature.SuperpositionOpenFeatureProvider)
         ships in Juspay's Superposition Java client; it transitively pulls an older
         dev.openfeature:sdk, which the starter pins to ${sdk.version} (lockstep). -->
    <superposition-openfeature.version>0.118.2</superposition-openfeature.version>
    <!-- Ageris's OpenFeature provider (io.github.lichtsinn:ageris-openfeature) declares
         dev.openfeature:sdk with provided scope, so it never pulls a transitive SDK
         version; the consumer's SDK arrives at ${sdk.version} through spring-openfeature. -->
    <ageris-openfeature.version>0.7.0</ageris-openfeature.version>
    <!-- CloudBees's OpenFeature provider (com.cloudbees.openfeature.provider.CloudbeesProvider);
         the provider declares dev.openfeature:sdk at an older version, which the starter
         pins to ${sdk.version} (lockstep). -->
    <cloudbees-openfeature.version>1.0.1</cloudbees-openfeature.version>
    <!-- ConfigDirector's OpenFeature provider (com.configdirector:configdirector-openfeature-server-provider)
         transitively pulls an older dev.openfeature:sdk, which the starter pins to
         ${sdk.version} (lockstep). -->
    <configdirector-openfeature.version>1.4.0</configdirector-openfeature.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp-bom</artifactId>
        <version>${okhttp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.16</version>
          <executions>
            <execution>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>verify</phase>
              <configuration>
                <dataFile>${project.build.directory}/jacoco.exec
                </dataFile>
                <outputDirectory>
                  ${project.reporting.outputDirectory}/jacoco
                </outputDirectory>
              </configuration>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                <haltOnFailure>true</haltOnFailure>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>INSTRUCTION</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${jacoco.instruction.minimum}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.6.0</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>12.3.1</version>
            </dependency>
            <dependency>
              <groupId>io.spring.javaformat</groupId>
              <artifactId>spring-javaformat-checkstyle</artifactId>
              <version>${io.spring.javaformat.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <id>checkstyle-validation</id>
              <phase>validate</phase>
              <inherited>true</inherited>
              <configuration>
                <configLocation>io/spring/javaformat/checkstyle/checkstyle.xml</configLocation>
                <includeTestSourceDirectory>false</includeTestSourceDirectory>
                <violationIgnore>SpringNullability</violationIgnore>
              </configuration>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>2.24.0</version>
      </plugin>
      <plugin>
        <groupId>io.spring.javaformat</groupId>
        <artifactId>spring-javaformat-maven-plugin</artifactId>
        <version>${io.spring.javaformat.version}</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <inherited>true</inherited>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.9.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>oss</flattenMode>
          <embedBuildProfileDependencies>true</embedBuildProfileDependencies>
          <pomElements>
            <distributionManagement>remove</distributionManagement>
            <repositories>remove</repositories>
            <dependencyManagement>remove</dependencyManagement>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <source>${java.version}</source>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>sonar</id>
      <modules>
        <module>aggregate-report</module>
      </modules>
    </profile>
    <profile>
      <id>examples</id>
      <modules>
        <module>examples</module>
      </modules>
    </profile>
    <profile>
      <id>publish</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- This is necessary for gpg to not try to use the pinentry programs -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <ignorePublishedComponents>true</ignorePublishedComponents>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>
</project>
